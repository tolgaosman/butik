# docker-compose.yml bu dosyayi (host'ta ".env" adiyla) okur.
# Sunucuda kopyalayin: cp .env.example .env  ve degerleri doldurun.

# Zorunlu. Uretmek icin: docker compose run --rm backend php artisan key:generate --show
APP_KEY=

DB_DATABASE=butik
DB_USERNAME=butikuser
DB_PASSWORD=
# root icin DB_PASSWORD'dan FARKLI bir sifre kullanin - ayni sifre olmasi guvenlik acigidir.
DB_ROOT_PASSWORD=

# Zorunlu. Siparis onayi, kargo bildirimi ve sifre sifirlama kodu bu SMTP uzerinden gider.
# MAIL_MAILER=log birakilirsa hicbir e-posta gonderilmez (yalnizca log dosyasina yazilir).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=siparis@sevgibutik.com
MAIL_FROM_NAME="Sevgi Butik"
