# Server components + build-time (generateStaticParams) fetch Laravel directly.
INTERNAL_API_URL=http://127.0.0.1:8000/api

# Browser fetches go through the Next.js rewrite proxy (see next.config.ts)
# so the Sanctum session cookie stays first-party. Leave as a relative path.
NEXT_PUBLIC_API_URL=/api

# Optional: overrides the backend the rewrite proxy targets. Defaults to
# http://127.0.0.1:8000 if unset.
BACKEND_URL=http://127.0.0.1:8000
